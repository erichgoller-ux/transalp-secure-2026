{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.local/schemas/ride-analysis-1.0.json",
  "title": "Northstar Ride Analysis",
  "description": "Versioniertes Austauschformat zwischen einer FIT-Tagesanalyse und der Northstar Transalp PWA.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schema_version",
    "created_at",
    "day",
    "variant",
    "source",
    "quality",
    "route",
    "battery",
    "model",
    "analysis"
  ],
  "properties": {
    "schema": {
      "const": "northstar.ride-analysis"
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string"
    },
    "day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "variant": {
      "enum": [
        "I",
        "II"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "app",
        "fit_filename",
        "analyzed_by"
      ],
      "properties": {
        "app": {
          "type": "string"
        },
        "fit_filename": {
          "type": "string"
        },
        "fit_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "analyzed_by": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "status",
        "confidence",
        "verified_fields"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "partial",
            "review"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verified_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "distance_km": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ascent_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "descent_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "active_time_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "elapsed_time_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "avg_speed_kmh": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_speed_kmh": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "battery": {
      "type": "object",
      "properties": {
        "start_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "end_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "charge_gain_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 200
        },
        "consumed_wh": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "useful_capacity_wh": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "point_index": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "actual_pct": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "charge_gain_pct": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "avg_hr_bpm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_hr_bpm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "avg_rider_power_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_rider_power_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "avg_motor_power_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_motor_power_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "support": {
          "type": "object",
          "properties": {
            "eco_time_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "trail_time_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "turbo_time_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "off_time_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "conditions": {
      "type": "object",
      "properties": {
        "weather": {
          "type": [
            "string",
            "null"
          ]
        },
        "surface": {
          "type": [
            "string",
            "null"
          ]
        },
        "temperature_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "wind_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "rider_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "predicted_wh_before"
      ],
      "properties": {
        "predicted_wh_before": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "deviation_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "calibration_factor_day": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "calibration_weight": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1.25
        },
        "recommended_learning_factor_after": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "summary",
        "causes",
        "next_day_action"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "causes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_day_action": {
          "type": "string"
        },
        "calibration_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}